# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# 10.0.2.2 = host machine as seen from the Android emulator
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- PostgreSQL ---
POSTGRES_DB=app_manager
POSTGRES_USER=app_manager
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- JWT (minutes / days) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=90

# --- Gunicorn (e.g. add --reload while developing) ---
GUNICORN_CMD_ARGS=--workers 3 --timeout 60 --reload

# --- Nginx ---
NGINX_PORT=8080
