# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# 10.0.2.2 = host machine as seen from the Android emulator
# With the Cloudflare Tunnel add its public hostname (e.g. appmanager.com.tr)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,appmanager.com.tr
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://appmanager.com.tr

# --- PostgreSQL ---
POSTGRES_DB=app_manager
POSTGRES_USER=app_manager
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- JWT (minutes / days) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=90

# --- Gunicorn (e.g. add --reload while developing) ---
GUNICORN_CMD_ARGS=--workers 3 --timeout 60 --reload

# --- Nginx ---
NGINX_PORT=80

# --- Cloudflare Tunnel ---
# Zero Trust > Networks > Tunnels > Create (cloudflared) > copy the token.
# Public hostname: appmanager.com.tr -> Service: HTTP, URL: nginx:80
# Comment COMPOSE_PROFILES out to run without the tunnel.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=change-me

# Market data sources (saving_invest); defaults are fine
# TCMB_RATES_URL=https://www.tcmb.gov.tr/kurlar/today.xml
# ALTINKAYNAK_GOLD_URL=https://static.altinkaynak.com/public/Gold
# Withholding tax on deposit interest (%)
# DEPOSIT_WITHHOLDING_RATE=17.5
