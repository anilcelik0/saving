# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# 10.0.2.2 = host machine as seen from the Android emulator
# With the Cloudflare Tunnel add its public hostname (e.g. appmanager.com.tr)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,appmanager.com.tr
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://appmanager.com.tr
# Production server only (served over HTTPS by Cloudflare): secure admin cookies, HSTS (e.g. 31536000)
# DJANGO_SECURE_COOKIES=True
# DJANGO_HSTS_SECONDS=0

# --- PostgreSQL ---
POSTGRES_DB=app_manager
POSTGRES_USER=app_manager
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- JWT (minutes / days) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=90

# --- Gunicorn (--reload only while developing; drop it on the production server) ---
GUNICORN_CMD_ARGS=--workers 3 --timeout 60 --reload

# --- Nginx ---
NGINX_PORT=80

# --- Legal texts (privacy policy, KVKK notice): data controller shown on the published pages ---
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=

# --- Production server only ---
# Use docker-compose.prod.yml (= docker-compose.yml + Cloudflare Tunnel) for every `docker compose` command:
# COMPOSE_FILE=docker-compose.prod.yml
# Cloudflare Tunnel: Zero Trust > Networks > Tunnels > (cloudflared) token;
# public hostname appmanager.com.tr -> Service: HTTP, URL: nginx:80
# CLOUDFLARE_TUNNEL_TOKEN=change-me

# Market data sources (saving_invest); defaults are fine
# TCMB_RATES_URL=https://www.tcmb.gov.tr/kurlar/today.xml
# ALTINKAYNAK_GOLD_URL=https://static.altinkaynak.com/public/Gold
# Withholding tax on deposit interest (%)
# DEPOSIT_WITHHOLDING_RATE=17.5

# Line Up energy; defaults are fine (dev: GRACE_DAYS=0 and REFILL_MINUTES=2 to see the limit quickly)
# LINEUP_ENERGY_MAX=5
# LINEUP_ENERGY_REFILL_MINUTES=25
# LINEUP_ENERGY_GRACE_DAYS=3
# LINEUP_DAILY_RESET=07:30            # Istanbul time a new daily puzzle starts (HH:MM)
